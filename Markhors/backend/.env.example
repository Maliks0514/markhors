# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/markhors
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/markhors
MONGODB_URI=mongodb://localhost:27017/markhors

# Server Port
PORT=5000

# CORS for Vercel backend deployment
# Example: https://your-frontend.vercel.app,https://admin.example.com
CORS_ORIGIN=*

# Environment
NODE_ENV=production
